# Copy this file to .env and fill in values.
# docker-compose reads this file for ${VAR} interpolation.

# --- OpenAI (required for chat, extraction, embeddings) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Auth ---
# Generate a strong value, e.g. `openssl rand -hex 32`. Override in production.
JWT_SECRET=dev-insecure-change-me

# ---------------------------------------------------------------------------
# The values below are already wired for local docker-compose and usually do
# not need changing for local development.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app
# REDIS_URL=redis://redis:6379
# STORAGE_ENDPOINT=http://minio:9000
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=prescriptions
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Transport & cookie security (production) ---
# Local dev leaves these off/false so HTTP works. In production set:
# ENFORCE_HTTPS=true        # redirect HTTP->HTTPS and send HSTS
# COOKIE_SECURE=true        # only send auth cookies over HTTPS
# COOKIE_SAMESITE=lax       # use "none" if frontend is a separate HTTPS origin
# TRUSTED_HOSTS=your-api.example.com   # comma-separated; "*" disables the check

